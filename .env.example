# --- VisionEngine ---
# 1 = örnek (mock) event üret, ağır YOLO pipeline çalışmaz (hızlı demo).
# 0 = gerçek pas tespiti (opencv/ultralytics/torch + yolo weights gerekir).
TACTIVISION_MOCK=0
TACTIVISION_ALLOW_MOCK_FALLBACK=0
TACTIVISION_YOLO_MODEL=yolo11n.pt

# --- AI Spiker (LLM) ---
# Sağlayıcı: gemini | template
TACTIVISION_LLM=gemini
# Google AI Studio'dan alınan anahtar (aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- TTS (Edge TTS Türkçe spiker sesi) ---
# Alternatif sesler: tr-TR-AhmetNeural (erkek), tr-TR-EmelNeural (kadın)
TACTIVISION_TTS_VOICE=tr-TR-AhmetNeural
TACTIVISION_TTS_RATE=+12%
